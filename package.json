{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node ./node_modules/next/dist/bin/next build --webpack",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "preview": "node_modules/.bin/opennextjs-cloudflare build && node_modules/.bin/opennextjs-cloudflare preview",
    "deploy": "bash ./scripts/run-production-deploy.sh",
    "preflight:client": "node scripts/preflight-client.mjs",
    "cf:env": "node scripts/prepare-cloudflare-env.mjs",
    "cf-typegen": "node ./node_modules/wrangler/bin/wrangler.js types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sbom": "cyclonedx-npm --output-file sbom.json",
    "test:isolation": "node --import tsx tests/isolation/seed.mts && vitest run --config tests/isolation/vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elevenlabs/react": "^1.6.5",
    "@google/genai": "^1.29.0",
    "@opentelemetry/api": "1.9.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/browser": "10.76.2",
    "@sentry/nextjs": "^10.63.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/postcss": "^4.2.1",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.31",
    "posthog-js": "^1.396.6",
    "posthog-node": "^5.39.4",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-leaflet": "5.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@fontsource/inter": "^5.2.8",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.62.1",
    "@types/dom-mediacapture-record": "1.0.22",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "ajv": "8.20.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.15",
    "typescript": "~5.8.2",
    "vitest": "^4.1.5",
    "webpack": "5.112.2",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "qs": "^6.16.1",
    "postcss": "^8.5.31",
    "glob": "14.0.2",
    "@node-minify/core": "9.0.2",
    "hyperid": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/api": "1.9.0"
  }
}
